NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/lms

JWT_SECRET=replace with any strong key
JWT_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=10

CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_ALLOW_SELF_SIGNED=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
RESET_PASSWORD_EXPIRES_MINUTES=15

# Admin registration security token (required to register first admin)
# Generate a strong random string for this (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_REGISTRATION_TOKEN=your_secure_admin_token_here

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE_SECONDS=3600

UPLOAD_PATH=uploads/
